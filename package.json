{
  "name": "rtn-frontend",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:calculations": "node --experimental-strip-types src/lib/batches/batch-calculations.test.ts",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "test:auth": "node --experimental-strip-types --test src/lib/auth/api.test.ts",
    "test:onboarding": "node --experimental-strip-types --test src/lib/onboarding/api.test.ts",
    "test:settings": "node --experimental-strip-types --test src/lib/settings/api.test.ts",
    "test:materials": "node --experimental-strip-types --test src/lib/materials/api.test.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
